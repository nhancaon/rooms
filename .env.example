# ================= ĐĂNG NHẬP GOOGLE =================
# Google Cloud Console > Google Auth Platform > Clients > Create client > Web application
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#                     và:  https://<tên-miền-của-bạn>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Chuỗi ngẫu nhiên để ký phiên đăng nhập. Tạo bằng: npx auth secret   (hoặc: openssl rand -base64 32)
# Dùng 1 chuỗi RIÊNG cho môi trường thật, không dùng chung với máy dev.
AUTH_SECRET=

# ================= PHÂN QUYỀN =================
# Email admin (vào được /admin, sửa/hủy/xóa mọi lịch), phân tách bằng dấu phẩy
ADMIN_EMAILS=
# (Tùy chọn) Chỉ cho email thuộc các tên miền này đăng nhập, vd: congty.com,doitac.vn. Bỏ trống = ai có tài khoản Google cũng vào được.
ALLOWED_EMAIL_DOMAINS=
# (Tùy chọn) Người CHƯA đăng nhập xem được gì: busy (mặc định) = chỉ thấy khung giờ đã kín; full = thấy cả chủ đề và tên người đặt.
GUEST_VIEW=

# ================= GOOGLE SHEETS (nơi lưu dữ liệu) =================
# 1) Google Cloud: bật Google Sheets API, tạo Service Account, tạo key JSON.
# 2) Tạo 1 Google Sheet trống, bấm Share, thêm email service account với quyền Editor.
# 3) Tab "Rooms" tự tạo ở lần chạy đầu; mỗi tháng có 1 tab "Bookings_YYYY-MM" tự tạo khi có lịch đầu tiên.
GOOGLE_SHEET_ID=                  # phần giữa /d/ và /edit trong URL của sheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=     # client_email trong file JSON
GOOGLE_PRIVATE_KEY=               # private_key trong file JSON, giữ nguyên các ký tự \n (có hoặc không có ngoặc kép đều được)
